{
  "model": "lgd",
  "task": "regression",
  "target": "realized_lgd",
  "framework": "aavas.automl.portfolio random search (lightgbm 4.7.0, scikit-learn 1.6.1, xgboost 3.2.0)",
  "metric": "mae_pts",
  "higher_is_better": false,
  "units": "pts",
  "quantiles": null,
  "features": [
    "ltv",
    "appraised_property_value",
    "sanctioned_loan_amount",
    "legal_flag",
    "technical_flag",
    "property_type",
    "city",
    "segment"
  ],
  "monotone_constraints": {
    "ltv": 1,
    "legal_flag": 1,
    "technical_flag": 1
  },
  "families_considered": [
    "random_forest",
    "extra_trees",
    "hist_gradient_boosting",
    "xgboost",
    "lightgbm"
  ],
  "families_skipped": [
    {
      "family": "ridge",
      "kind": "excluded",
      "reason": "the contract carries monotone constraints (ltv, legal_flag, technical_flag) and sklearn's Ridge / LogisticRegression take no sign constraint on a coefficient, so the contract's monotone direction could not be guaranteed"
    },
    {
      "family": "catboost",
      "kind": "excluded",
      "reason": "the contract carries monotone constraints (ltv, legal_flag, technical_flag) and with monotone constraints CatBoost's SHAP values depend on the batch they are computed over, so a per-loan explanation would not be reproducible"
    }
  ],
  "budget_per_family": {
