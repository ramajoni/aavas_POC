# Copy to .env and adjust. Everything has a safe default: the POC runs with no .env at all.

AAVAS_ENV=local
AAVAS_LOG_LEVEL=INFO

# Governance store. Default is a local SQLite file; point at Postgres for a shared deployment.
AAVAS_STORE_URL=sqlite:///aavas_governance.db

# Knowledge / vector store. "memory" needs nothing; "pgvector" needs AAVAS_PG_DSN.
AAVAS_VECTOR_BACKEND=memory
AAVAS_PG_DSN=postgresql://aavas:aavas@localhost:5432/aavas

# Experiment tracking (mlflow). Disabled by default so training never needs a server.
AAVAS_TRACKING_ENABLED=false
MLFLOW_TRACKING_URI=file:./mlruns

# Reproducibility
AAVAS_SEED=42

# API
AAVAS_API_HOST=0.0.0.0
AAVAS_API_PORT=8000

# ------------------------------------------------------------------ Claude / LLM
# Unprefixed on purpose: the `anthropic` SDK reads this name automatically.
# Put the real key in .env (git-ignored), never in this file.
ANTHROPIC_API_KEY=

# LLM-assisted sales-note extraction (docs/target-architecture-gap.md §10).
# Off by default: the engine must run with no key.
AAVAS_LLM_ENABLED=false
AAVAS_LLM_MODEL=claude-opus-5

# AI explanation on the loan explanation page. Available whenever ANTHROPIC_API_KEY is set;
# independent of AAVAS_LLM_ENABLED. Defaults to claude-opus-5-5.
# AAVAS_LLM_EXPLAIN_MODEL=claude-opus-5-5
